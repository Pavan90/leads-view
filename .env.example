# Copy to .env.local and fill in. With every value left unset the app serves
# the fixtures in data/leads.json, so it runs with no configuration at all.
#
# Setting these is the entire switch to live data — no code change needed.
# Restart `next dev` after editing; env vars are read at server start.

# ── Lead API ─────────────────────────────────────────────────────────
# One base URL per environment, matching the Dev/UAT/Prod switcher.
# The app appends /getleads and /submissionbyid; change those paths in
# app/api/leads/route.ts and app/api/submissions/[id]/route.ts if yours differ.
LEADS_API_URL_DEV=
LEADS_API_URL_UAT=
LEADS_API_URL_PROD=

# Use this instead when a single host serves every environment.
LEADS_API_URL=

# ── Auth ─────────────────────────────────────────────────────────────
# Client-credentials token exchange. The secret stays server-side; never
# move these to a NEXT_PUBLIC_* name, which would ship them to the browser.
LEADS_AUTH_URL=
LEADS_CLIENT_ID=
LEADS_CLIENT_SECRET=
LEADS_AUTH_SCOPE=

# Per-environment overrides are supported by suffixing the name, e.g.
# LEADS_CLIENT_ID_UAT=...
